rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==============================================================
    // CORE AUTHENTICATION & RBAC HELPER FUNCTIONS
    // ==============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : {};
    }

    function getUserRole() {
      return getUserData().get('role', 'none');
    }

    function getUserStatus() {
      return getUserData().get('status', 'Active');
    }

    // Account is valid and active (not locked, not deleted)
    function isActiveAccount() {
      let status = getUserStatus();
      return status != 'Locked' && status != 'Deleted' && status != 'Deleted by Resident';
    }

    // Super Admin: highest authority
    function isSuperAdmin() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        role == 'superadmin' || 
        role == 'SuperAdmin' || 
        role == 'Super Admin'
      );
    }

    // Full Admin: operational administration
    function isFullAdmin() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        isSuperAdmin() || 
        role == 'admin' || 
        role == 'Admin' || 
        role == 'Full Access'
      );
    }

    // Any Admin (including specialized roles & view only)
    function isAnyAdmin() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        isFullAdmin() ||
        role == 'Resident Management' ||
        role == 'Verifications' || 
        role == 'Verification Only' ||
        role == 'Document Processing' || 
        role == 'Documents Only' ||
        role == 'View Only'
      );
    }

    // Role-specific mutation permissions
    function canManageResidents() {
      let role = getUserRole();
      return isFullAdmin() || (isAuthenticated() && isActiveAccount() && role == 'Resident Management');
    }

    function canManageVerifications() {
      let role = getUserRole();
      return isFullAdmin() || (isAuthenticated() && isActiveAccount() && (role == 'Verifications' || role == 'Verification Only'));
    }

    function canManageRequests() {
      let role = getUserRole();
      return isFullAdmin() || (isAuthenticated() && isActiveAccount() && (role == 'Document Processing' || role == 'Documents Only'));
    }

    function isOwner(userId) {
      return isAuthenticated() && isActiveAccount() && request.auth.uid == userId;
    }

    // ==============================================================
    // USERS COLLECTION
    // ==============================================================
    match /users/{userId} {
      // Any admin or the account owner can read the profile
      allow read: if isAnyAdmin() || isOwner(userId);
      
      // Account Creation:
      // - Super Admin can provision accounts.
      // - Residents can only self-register with role='resident', isVerified=false, status='Pending' (#29).
      allow create: if (
        isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.data.role == 'resident' &&
        request.resource.data.isVerified == false &&
        (request.resource.data.status == 'Pending' || request.resource.data.status == 'pending') &&
        (!('accountExpiry' in request.resource.data) || request.resource.data.accountExpiry == '')
      );
      
      // Updates:
      // Privileged changes are server-only typed operations. Residents retain
      // only the explicit contact/photo and self-deactivation transitions.
      allow update: if isOwner(userId) && (
          // Self-profile edits: restricted to non-sensitive contact/photo fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'contactNumber', 'profilePicture', 'updatedAt'
          ]) ||
          // Self-deactivation flow (#26)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            request.resource.data.status == 'Deleted by Resident' &&
            resource.data.status != 'Deleted'
          )
        );
      
      // Deletions: Only Super Admin can hard-delete user documents.
      allow delete: if false;
    }

    // ==============================================================
    // DOCUMENT REQUESTS COLLECTION
    // ==============================================================
    match /documentRequests/{requestId} {
      // Admins can see all. Residents see their own.
      allow read: if isAnyAdmin() || (isAuthenticated() && resource.data.residentId == request.auth.uid);
      
      // Creation:
      // Creation:
      // Direct client creation by residents is blocked to prevent fee tampering and forged waivers (#56).
      // Residents must create requests via the protected server route /api/resident/requests/create.
      allow create: if false;
      
      // Updates:
      // - Document Processing / Full Admin can update everything.
      // - Residents can only perform validated transitions (#26, #56):
      //   1. Cancel a Pending request: status -> 'Cancelled'
      //   2. Submit Payment: paymentStatus -> 'pending_verification'
      allow update: if (
        isAuthenticated() &&
        isActiveAccount() &&
        resource.data.residentId == request.auth.uid &&
        request.resource.data.residentId == resource.data.residentId &&
        (
          // Case 1: Cancellation transition
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'statusTimestamps']) &&
            resource.data.status == 'Pending' &&
            request.resource.data.status == 'Cancelled'
          ) ||
          // Case 2: Payment submission transition
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus', 'paymentMethod', 'gcashRefNumber', 'gcashScreenshotUrl', 'paymentSubmittedAt'
            ]) &&
            request.resource.data.paymentStatus == 'pending_verification' &&
            resource.data.status in ['Pending', 'Approved', 'Processing', 'On Process']
          )
        )
      );

      // Deletions:
      // - Super Admin can delete.
      // - Residents can ONLY delete requests if still Pending or Cancelled (cannot delete processed/receipted requests) (#56).
      allow delete: if (
        isAuthenticated() &&
        resource.data.residentId == request.auth.uid &&
        resource.data.status in ['Pending', 'Cancelled']
      );
    }

    // ==============================================================
    // VERIFICATIONS COLLECTION
    // ==============================================================
    match /verifications/{verificationId} {
      allow read: if isAnyAdmin() || (
        isAuthenticated() && 
        (resource.data.residentId == request.auth.uid || resource.data.userId == request.auth.uid)
      );
      
      // Creation:
      // - Residents can create verification for themselves, BUT status MUST be 'pending' (#57).
      // - Single canonical owner (A01): reject conflicting residentId/userId fields and submissions targeting another resident.
      allow create: if (
        isAuthenticated() &&
        isActiveAccount() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in ['registration', 'profile-edit', 'reactivation'] &&
        (
          (!('residentId' in request.resource.data) || request.resource.data.residentId == request.auth.uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
          (('residentId' in request.resource.data) || ('userId' in request.resource.data)) &&
          (!('residentId' in request.resource.data && 'userId' in request.resource.data) || request.resource.data.residentId == request.resource.data.userId)
        )
      );
      
      // Review transitions are coupled to audit/notification/identity state by
      // trusted server operations; no client role may write them directly.
      allow update: if false;

      // Deletions:
      // - Super Admin can delete.
      // - Residents can ONLY withdraw unreviewed 'pending' verifications (#57).
      allow delete: if (
        isAuthenticated() &&
        (resource.data.residentId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        resource.data.status == 'pending'
      );
    }

    // ==============================================================
    // NOTIFICATIONS COLLECTION
    // ==============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetId == request.auth.uid || 
        (resource.data.targetId == 'admin' && isAnyAdmin())
      );
      
      // Creation:
      // - Admins can notify anyone.
      // - Residents can ONLY create notification with targetId == 'admin' (#58 impersonation defense).
      // - Allow registration and reactivation notification types to admin (A10).
      allow create: if (
        isAuthenticated() &&
        request.resource.data.targetId == 'admin' &&
        request.resource.data.type in ['info', 'alert', 'registration', 'reactivation']
      );
      
      allow update, delete: if isAuthenticated() && (
        resource.data.targetId == request.auth.uid || 
        (resource.data.targetId == 'admin' && isAnyAdmin())
      );
    }

    // ==============================================================
    // ACTIVITY LOGS COLLECTION
    // ==============================================================
    match /activityLogs/{logId} {
      allow read: if isAnyAdmin();
      // Authoritative mutation evidence is server-authored only. Admin SDK
      // bypasses client rules inside trusted mutation operations.
      allow create: if false;
      allow update, delete: if false;
    }

    match /clientTelemetry/{telemetryId} {
      allow read, write: if false;
    }

    match /mediaRegistry/{assetId} {
      allow read, write: if false;
    }

    // ==============================================================
    // SYSTEM ALERTS & SYSTEM CONFIG
    // ==============================================================
    match /systemAlerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ==============================================================
    // BACKUP LOGS COLLECTION
    // ==============================================================
    match /backupLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false; 
    }

    // ==============================================================
    // DEFAULT DENY
    // ==============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
