rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // CORE AUTHENTICATION & RBAC HELPER FUNCTIONS
    // ==============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : {};
    }

    function getUserRole() {
      return getUserData().get('role', 'none');
    }

    function getUserStatus() {
      return getUserData().get('status', 'none');
    }

    function hasAuthoritativeUserProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Account is valid and active (not locked, not deleted, not registration-denied)
    function isActiveAccount() {
      let status = getUserStatus();
      let user = getUserData();
      return hasAuthoritativeUserProfile() &&
        status != 'Locked' &&
        status != 'Deleted' &&
        status != 'Deleted by Resident' &&
        user.get('role', 'none') != 'Deleted' &&
        user.get('registrationDenied', false) != true &&
        !('deniedAt' in user) &&
        !(user.get('isVerified', false) == false && (status == 'Deleted' || status == 'Expired'));
    }

    function isUnverifiedResident() {
      let user = getUserData();
      return hasAuthoritativeUserProfile() &&
        user.get('role', 'none') == 'resident' &&
        user.get('isVerified', false) == false;
    }

    function isResident() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (role == 'resident' || role == 'Resident');
    }

    // Super Admin: highest authority
    function isSuperAdmin() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        role == 'superadmin' ||
        role == 'SuperAdmin' ||
        role == 'Super Admin'
      );
    }

    // Full Admin: operational administration
    function isFullAdmin() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        isSuperAdmin() ||
        role == 'admin' ||
        role == 'Admin' ||
        role == 'Full Access'
      );
    }

    // Any Admin (including specialized roles & view only)
    function isAnyAdmin() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        role == 'superadmin' || role == 'SuperAdmin' || role == 'Super Admin' ||
        role == 'admin' || role == 'Admin' || role == 'Full Access' ||
        role == 'Resident Management' ||
        role == 'Verifications' || role == 'Verification Only' ||
        role == 'Document Processing' || role == 'Documents Only' ||
        role == 'View Only'
      );
    }

    // Role-specific mutation permissions
    function canManageResidents() {
      let role = getUserRole();
      return isFullAdmin() || (isAuthenticated() && isActiveAccount() && role == 'Resident Management');
    }

    function canManageVerifications() {
      let role = getUserRole();
      return isFullAdmin() || (isAuthenticated() && isActiveAccount() && (role == 'Verifications' || role == 'Verification Only'));
    }

    function canManageRequests() {
      let role = getUserRole();
      return isFullAdmin() || (isAuthenticated() && isActiveAccount() && (role == 'Document Processing' || role == 'Documents Only'));
    }

    function canManageNotifications() {
      let role = getUserRole();
      return isAuthenticated() && isActiveAccount() && (
        role == 'superadmin' || role == 'SuperAdmin' || role == 'Super Admin' ||
        role == 'admin' || role == 'Admin' || role == 'Full Access' ||
        role == 'Resident Management' ||
        role == 'Verifications' || role == 'Verification Only' ||
        role == 'Document Processing' || role == 'Documents Only'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && isActiveAccount() && request.auth.uid == userId;
    }

    // ==============================================================
    // USERS COLLECTION
    // ==============================================================
    match /users/{userId} {
      // Any admin or the account owner can read the profile
      allow read: if isAnyAdmin() || isOwner(userId);

      // Initial resident/admin profiles are created only by trusted server operations.
      allow create: if false;

      // Updates:
      // Privileged changes are server-only typed operations. Residents retain
      // only the explicit contact/photo and self-deactivation transitions.
      allow update: if isOwner(userId) && (
          // Self-profile edits: restricted to non-sensitive contact/photo fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'contactNumber', 'profilePicture', 'updatedAt'
          ]) ||
          // Self-deactivation flow (#26)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            request.resource.data.status == 'Deleted by Resident' &&
            resource.data.status != 'Deleted'
          )
        );

      // Deletions: Only Super Admin can hard-delete user documents.
      allow delete: if false;
    }

    // ==============================================================
    // DOCUMENT REQUESTS COLLECTION
    // ==============================================================
    match /documentRequests/{requestId} {
      // Admins can see all. Active residents see their own.
      allow read: if isAnyAdmin() || (
        isAuthenticated() &&
        isActiveAccount() &&
        resource.data.residentId == request.auth.uid
      );

      // Creation:
      // Direct client creation by residents is blocked to prevent fee tampering and forged waivers (#56).
      // Residents must create requests via the protected server route /api/resident/requests/create.
      allow create: if false;

      // Updates:
      // - Administrative request updates are performed authoritatively by server operations.
      // - SEC-F02: Payment submissions are strictly server-authoritative via POST /api/resident/requests/pay.
      // - Residents can ONLY update their own Pending requests to Cancelled (Cancellation transition).
      allow update: if (
        isAuthenticated() &&
        isActiveAccount() &&
        resource.data.residentId == request.auth.uid &&
        request.resource.data.residentId == resource.data.residentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'statusTimestamps']) &&
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Cancelled'
      );

      // Deletions:
      // - Super Admin can delete.
      // - Residents can ONLY delete requests if still Pending or Cancelled (cannot delete processed/receipted requests) (#56).
      allow delete: if (
        isAuthenticated() &&
        isActiveAccount() &&
        resource.data.residentId == request.auth.uid &&
        resource.data.status in ['Pending', 'Cancelled']
      );
    }

    // ==============================================================
    // VERIFICATIONS COLLECTION
    // ==============================================================
    match /verifications/{verificationId} {
      allow read: if isAnyAdmin() || (
        isAuthenticated() &&
        isActiveAccount() &&
        (resource.data.residentId == request.auth.uid || resource.data.userId == request.auth.uid)
      );

      // Creation:
      // - Residents can create verification for profile-edit or reactivation for themselves; status MUST be 'pending' (#57).
      // - Initial registration and registration resubmissions are created ONLY by trusted server operations (/api/resident/registration/finalize and /api/resident/registration/resubmit).
      // - Single canonical owner (A01): reject conflicting residentId/userId fields and submissions targeting another resident.
      allow create: if (
        isAuthenticated() &&
        isActiveAccount() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in ['profile-edit', 'reactivation'] &&
        (
          (!('residentId' in request.resource.data) || request.resource.data.residentId == request.auth.uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
          (('residentId' in request.resource.data) || ('userId' in request.resource.data)) &&
          (!('residentId' in request.resource.data && 'userId' in request.resource.data) || request.resource.data.residentId == request.resource.data.userId)
        )
      );

      // Review transitions are coupled to audit/notification/identity state by
      // trusted server operations; no client role may write them directly.
      allow update: if false;

      // Deletions:
      // - Direct client deletion of 'registration' verifications is STRICTLY FORBIDDEN for all roles (including Super Admin).
      //   Administrative deletion of registration verifications must use coordinated server-authoritative operation
      //   (POST /api/admin/operations with operation 'verification.delete') to maintain transactional consistency across
      //   residentVerificationLocks, users.hasPendingVerification, and audit logs.
      // - Residents can withdraw unreviewed 'pending' verifications of type 'profile-edit' or 'reactivation' (#57, R09),
      //   and dismiss 'rejected' verifications of type 'profile-edit' to revert to previously valid documents (F01).
      // - Super Admins may directly delete non-registration verifications (e.g., profile-edit or reactivation).
      allow delete: if (
        resource.data.type != 'registration' && (
          isSuperAdmin() || (
            isAuthenticated() &&
            isActiveAccount() &&
            (resource.data.residentId == request.auth.uid || resource.data.userId == request.auth.uid) &&
            (
              (resource.data.status == 'pending' && resource.data.type in ['profile-edit', 'reactivation']) ||
              (resource.data.status == 'rejected' && resource.data.type == 'profile-edit')
            )
          )
        )
      );
    }

    // ==============================================================
    // NOTIFICATIONS COLLECTION
    // ==============================================================
    match /notifications/{notificationId} {
      allow read: if (
        (isAnyAdmin() && (resource.data.targetId == 'admin' || resource.data.targetId == request.auth.uid)) ||
        (isAuthenticated() && isActiveAccount() && resource.data.targetId == request.auth.uid)
      );

      // Creation (P04):
      // - Operational Admins can notify anyone (View Only is strictly read-only and cannot create notifications).
      // - Residents can ONLY create notifications with targetId == 'admin' (impersonation defense).
      // - View Only administrator is denied client creation targeting either residents or admins.
      allow create: if (
        (
          isResident() &&
          request.resource.data.targetId == 'admin' &&
          request.resource.data.type in ['info', 'alert', 'reactivation'] &&
          (
            !('actionUrl' in request.resource.data) ||
            request.resource.data.actionUrl in ['/admin/verifications', '/admin/requests/payments', '/admin/requests']
          )
        ) ||
        canManageNotifications()
      );

      // Updates (P04):
      // - View Only is denied all updates.
      // - Operational Admins and Residents can only update the read status field (isRead), preventing arbitrary mutation.
      allow update: if (
        (
          canManageNotifications() &&
          (resource.data.targetId == 'admin' || resource.data.targetId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        ) ||
        (
          isResident() &&
          resource.data.targetId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        )
      );

      // Shared staff notifications are never physically deleted by a client;
      // staff clear only their own notificationDismissals view state below.
      // Residents may permanently delete only notifications they own.
      allow delete: if isResident() && resource.data.targetId == request.auth.uid;
    }

    // Per-user view state for shared staff notifications. The shared source
    // notification remains intact for every other staff account.
    match /notificationDismissals/{dismissalId} {
      allow read: if isAnyAdmin() && resource.data.userId == request.auth.uid;
      allow create: if isAnyAdmin() &&
        request.resource.data.userId == request.auth.uid &&
        dismissalId == request.auth.uid + '_' + request.resource.data.notificationId &&
        request.resource.data.keys().hasOnly(['userId', 'notificationId', 'dismissedAt']) &&
        request.resource.data.notificationId is string &&
        request.resource.data.notificationId.size() > 0 &&
        request.resource.data.dismissedAt is int;
      allow update: if isAnyAdmin() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.notificationId == resource.data.notificationId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt']) &&
        request.resource.data.dismissedAt is int;
      allow delete: if isAnyAdmin() && resource.data.userId == request.auth.uid;
    }

    // ==============================================================
    // ACTIVITY LOGS COLLECTION
    // ==============================================================
    match /activityLogs/{logId} {
      allow read: if isAnyAdmin();
      // Authoritative mutation evidence is server-authored only. Admin SDK
      // bypasses client rules inside trusted mutation operations.
      allow create: if false;
      allow update, delete: if false;
    }

    match /clientTelemetry/{telemetryId} {
      allow read, write: if false;
    }

    match /mediaRegistry/{assetId} {
      allow read, write: if false;
    }

    match /registrationOperations/{operationId} {
      allow read, write: if false;
    }

    match /residentVerificationLocks/{residentId} {
      allow read, write: if false;
    }

    // ==============================================================
    // SYSTEM ALERTS & SYSTEM CONFIG
    // ==============================================================
    match /systemAlerts/{alertId} {
      allow read: if isAuthenticated() && isActiveAccount();
      allow create, update, delete: if false;
    }

    match /systemConfig/{configId} {
      allow read: if isAuthenticated() && isActiveAccount();
      allow create, update, delete: if false;
    }

    // ==============================================================
    // BACKUP LOGS COLLECTION
    // ==============================================================
    match /backupLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ==============================================================
    // DEFAULT DENY
    // ==============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
